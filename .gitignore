# Dépendances installées par npm (recréées avec `npm install`)
node_modules/

# Versions compilées (recréées avec `npm run build`)
dist/

# Rapports de tests
coverage/
test-results/
playwright-report/

# Fichiers temporaires de TypeScript
*.tsbuildinfo

# Secrets et réglages locaux (ne jamais publier)
.env
.env.*
!.env.example

# Journaux
*.log

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# Réglages personnels de l'éditeur
.vscode/*
!.vscode/extensions.json
